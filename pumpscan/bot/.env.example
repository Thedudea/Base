# --- GMGN (official API: https://gmgn.ai/ai) ------------------------------
# Filled in automatically by `npx gmgn-cli config --apply <API_KEY>` (it writes ~/.config/gmgn/.env);
# you can also put them here. Never share these or commit this file.
GMGN_API_KEY=
GMGN_PRIVATE_KEY=

# Your GMGN wallet address on Robinhood Chain (use a separate wallet with only the bot's budget)
WALLET=0x

# --- Safety ------------------------------------------------------------------
# 1 = test mode: only logs / Telegram "would buy", no real trades. Set to 0 to trade for real.
DRY_RUN=1
# ETH per buy
BUY_ETH=0.002
MAX_BUYS_PER_DAY=20
MAX_OPEN_POSITIONS=10
# Slippage % for buys and the 6h sell
SLIPPAGE=15
# 1 = only buy tokens that are DEX-paid on DexScreener (the "F4 + DEX paid" variant)
REQUIRE_DEX_PAID=0
# 1 = also buy tokens that are already in the list when the bot starts (default: no)
BUY_ON_START=0
POLL_SEC=60

# --- F4 filter (GMGN Trending, 1h window) — values from the one-week test ----
F_MIN_LIQ=70000
F_MAX_ATH_MC=160000
F_MIN_VOL_1H=70000
F_MAX_TXS_1H=900

# --- Exits (attached to every buy on GMGN) -----------------------------------
# at +TP_PCT% sell TP_SELL% of the buy; the rest trails TRAIL_DD% below its peak; stop-loss at -SL_PCT%
TP_PCT=100
TP_SELL=50
TRAIL_DD=35
SL_PCT=35
# whatever is still held after HOLD_HOURS is sold by the bot
HOLD_HOURS=6

# --- Telegram (optional) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
